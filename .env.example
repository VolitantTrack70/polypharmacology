# Copy to .env and adjust. Never commit .env.

# --- Postgres (Apache AGE image) ---
POSTGRES_USER=chemmed
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=chemmed
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://chemmed:change_me_locally@localhost:5432/chemmed

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_COMPOUNDS=chemmed.compounds.raw
KAFKA_TOPIC_FINGERPRINTS=chemmed.compounds.fingerprinted
KAFKA_INGEST_GROUP=chemmed-fingerprint-workers

# --- Services ---
API_BIND_ADDR=0.0.0.0:8080
CHEMWORKER_GRPC_ADDR=localhost:50051
RUST_LOG=info,chemmed_api=debug

# --- Cheminformatics ---
# Morgan fingerprint config. Changing these invalidates the fingerprint index.
FP_RADIUS=2
FP_NBITS=2048
# See docs/decisions/0002-similarity-thresholds.md before changing.
DEFAULT_TANIMOTO_CUTOFF=0.40
DEFAULT_PCHEMBL_CUTOFF=6.0

# --- Data paths ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
FPSIM2_INDEX_PATH=./data/processed/chembl_morgan_2048.h5
